{
  "harness": "hermes",
  "name": {"zh": "Hermes", "en": "Hermes"},
  "headless": {
    "command": ["hermes", "chat", "--oneshot", "-q", "{prompt}"],
    "output": ["--format", "stream-json"],
    "final_text": "$.text",
    "usage": {"file": "usage.json", "input": "$.input_tokens", "output": "$.output_tokens", "cache_read": "$.cache_read_tokens", "cache_write": "$.cache_write_tokens", "model": "$.model"},
    "session": {"extract": "$.session_id"},
    "resume": ["--resume", "{session_id}"],
    "access": {
      "read": ["-t", "apa,no_mcp"],
      "edit": ["-t", "apa,file,terminal,no_mcp"],
      "full": ["--yolo", "-t", "apa,file,terminal,no_mcp"]
    },
    "no_persona": ["--ignore-rules"],
    "effort": ["--reasoning", "{effort}"],
    "tools": {
      "read": [{"zh": "APA", "en": "APA"}],
      "edit": [{"zh": "APA", "en": "APA"}, {"zh": "文件", "en": "Files"}, {"zh": "终端", "en": "Terminal"}],
      "full": [{"zh": "APA", "en": "APA"}, {"zh": "文件", "en": "Files"}, {"zh": "终端", "en": "Terminal"}]
    },
    "tool_notes": {"full": {"zh": "不再逐项问你", "en": "Stops asking you each time"}},
    "credential": "env",
    "exit_codes": {"ok": [0], "session_missing": [1, 2]},
    "exit_output": {"session_missing": ["No session found matching", "Resume retains gateway session policy"]}
  },
  "main_session": {}
}
